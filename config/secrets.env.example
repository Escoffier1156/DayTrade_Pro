# 実際の値は config/secrets.env に書く（.gitignore 済み）
#   cp config/secrets.env.example config/secrets.env
# 形式: KEY=VALUE  1行1件。# 始まりはコメント。値のクォートは不要。

# --- J-Quants API V2 ---
# https://jpx-jquants.com/ のダッシュボードで発行する APIキー。
# V2 は x-api-key ヘッダ1本。refreshToken / idToken は V1 で廃止済み。
JQUANTS_API_KEY=

# --- Slack ---
# chat.update（ポジション一覧の常時更新）には Bot Token が必須。
# Incoming Webhook だけでは chat.update が使えない。
# Slack App を作成し、スコープ chat:write を付与して取得する xoxb- で始まる文字列。
SLACK_BOT_TOKEN=

# チャンネルIDは名前ではなくID（C から始まる）を入れる。名前は改名で壊れるため。
SLACK_CHANNEL_CANDIDATES=
SLACK_CHANNEL_ALERTS=
SLACK_CHANNEL_SIGNALS=
SLACK_CHANNEL_SYSTEM=
SLACK_CHANNEL_REPORTS=
